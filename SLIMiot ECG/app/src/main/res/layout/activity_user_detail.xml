<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".Home.UserDetail">


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/textView30"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="20dp"
                android:text="Data Info"
                android:layout_weight="1"
                android:fontFamily="@font/textfont"
                android:textColor="@color/textColor"
                android:textSize="24sp"
                android:textStyle="bold"
                />



        </LinearLayout>

        <TextView
            android:id="@+id/textView33"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="20dp"
            android:layout_marginRight="20dp"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="20dp"
            android:fontFamily="@font/textfont"
            android:text="Please fill the following field for the PPG Analysis :"
            android:textColor="@color/textColor"
            android:textSize="20sp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="20dp"
            android:layout_marginTop="30dp"
            android:layout_marginRight="20dp"
            android:orientation="horizontal">
            <TextView
                android:layout_width="130dp"
                android:layout_height="wrap_content"
                android:fontFamily="@font/textfont"
                android:textColor="@color/textColor"
                android:textSize="@dimen/text_size"
                android:layout_marginRight="10dp"
                android:text="Service UUID"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/textfont"
                android:textColor="@color/textColor"
                android:layout_marginRight="10dp"
                android:textSize="@dimen/text_size"
                android:text="1890"/>


        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="20dp"
            android:layout_marginTop="30dp"
            android:layout_marginRight="20dp"
            android:orientation="horizontal">
            <TextView
                android:layout_width="130dp"
                android:layout_height="wrap_content"
                android:fontFamily="@font/textfont"
                android:textColor="@color/textColor"
                android:layout_marginRight="10dp"
                android:textSize="@dimen/text_size"
                android:text="Characteristic UUID"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/textfont"
                android:textColor="@color/textColor"
                android:layout_marginRight="10dp"
                android:textSize="@dimen/text_size"
                android:text="1901"/>


        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="20dp"
            android:layout_marginTop="30dp"
            android:layout_marginRight="20dp"
            android:orientation="horizontal">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/textfont"
                android:textColor="@color/textColor"
                android:layout_marginRight="10dp"
                android:textSize="@dimen/text_size"
                android:layout_gravity="center"
                android:text="Data format"/>

            <Spinner
                android:layout_width="230dp"
                android:layout_height="wrap_content"
                android:id="@+id/dataFormatSpinner"
                android:fontFamily="@font/textfont"
                android:textColor="@color/textColor"
                android:textSize="@dimen/text_size"
                />


        </LinearLayout>

        <LinearLayout
            android:layout_width="200dp"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            android:layout_marginTop="20dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/nextButton"
                android:layout_width="200dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="Next"
                android:textStyle="bold"
                android:fontFamily="@font/textfont"
                android:textSize="15sp"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textColorLink="#FFFFFF"
                app:cornerRadius="20dp" />
        </LinearLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>